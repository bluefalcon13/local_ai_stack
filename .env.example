# ==============================================================================
# Local AI Stack Environment & Secrets Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# --- Configuration Root & Pathing (The Portal) ---
# Defaults to ./configs for local dev, or /var/lib/localaistack-configs for service user portal
CONFIG_ROOT=./configs

# --- Hugging Face Access (Required for gated models like Gemma-4) ---
HF_TOKEN=your_huggingface_token_here

# --- AMD Developer Credentials (For Ryzen AI NPU packages & tools) ---
AMD_DEV_USERNAME=your_email@example.com
AMD_DEV_PASSWORD=your_password_here

# --- Hardware Acceleration GIDs (From host `getent group video/render`) ---
HOST_VIDEO_GID=983
HOST_RENDER_GID=987

# --- ONNX Worker Execution Provider (VitisAI for NPU, CPU for fallback) ---
ONNX_PROVIDER=VitisAI

# --- Model Selection ---
LRM_MODEL=/models/gemma-4-26B-A4B-it-qat-w4a16-ct
WORKER_MODEL=amd/Qwen2.5-Coder-1.5B-Instruct_rai_1.9.0_npu
MODEL_PATH=/root/models/qwen-1.5b-npu

# --- Service Ports ---
LRM_PORT=8000
WORKER_PORT=8001
ORCHESTRATOR_PORT=8080
QDRANT_PORT=6333
EMBED_PORT=8002
RERANK_PORT=8003

# --- Cloudflare Zero Trust (Optional Tunnel Token) ---
TUNNEL_TOKEN=

# # --- Pathing (The Portal) ---
# CONFIG_ROOT=/var/lib/localaistack-configs
# CERT_DIR=/data

# # --- Service User ---
# SERVICE_UID=1100
# SERVICE_USER=ai-svc

# # --- Domain & Security ---
# BASE_DOMAIN=your.fqdn.com
# CLOUDFLARE_TUNNEL_TOKEN=your_token_here
# TLS_CLIENT_CERT_NAME=somefilename.pem
# TLS_CLIENT_KEY_NAME=someotherfilename.pem
# CLOUDFLARE_AUTH_ORIGIN_PULL_CERT_NAME=athirdfilename.pem
# CLOUDFLARE_EMAIL=youremail@provider.com

# # --- IDENTITY & NETWORK ---
# WEBUI_SECRET=generate_a_long_random_hex
# WEBUI_ADMIN_EMAIL=some-email.gmail.com
# WEBUI_ADMIN_PASSWORD=supersecretpassword

# # --- GOOGLE OAUTH ---
# GOOGLE_ID=your_id.apps.googleusercontent.com
# GOOGLE_SECRET=your_client_secret

# # --- DATABASE (LangGraph) ---
# POSTGRES_USER=pguser_admin
# POSTGRES_PASSWORD=secure_db_password
# POSTGRES_DB=langgraph_state

# # --- SEARCH & TRACING (New Secrets) ---
# # SearXNG needs a secret to sign its internal requests
# SEARXNG_SECRET=another_random_hex
# # Phoenix tracing auth (if enabled)
# PHOENIX_SECRET=third_random_hex